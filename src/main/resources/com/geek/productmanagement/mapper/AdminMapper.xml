<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace = 'com.geek.productmanagement.mapper.AdminMapper'>

    <select id = 'findByEmail' resultType = 'com.geek.productmanagement.entity.Admin'>

        SELECT *
        FROM admins
        WHERE email = #{email}

    </select>

</mapper>